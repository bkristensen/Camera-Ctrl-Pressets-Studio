<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net48</TargetFramework>
  <UseWindowsForms>true</UseWindowsForms>
  <EnableWindowsTargeting>true</EnableWindowsTargeting>
  <AssemblyName>Camera Control Studio</AssemblyName>
  <RootNamespace>CameraControlStudio</RootNamespace>
  <ApplicationIcon>Assets/CameraControlStudio.ico</ApplicationIcon>
  <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
</PropertyGroup>
<ItemGroup>
  <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  <Reference Include="System.Runtime.Serialization" />
  <Reference Include="System.Net.Http" />
  <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  <EmbeddedResource Include="../Shared/Locales/*.xml" LogicalName="CamPressets.Locales.%(Filename).xml" />
  <Compile Update="Forms/*Form.cs">
    <SubType>Form</SubType>
  </Compile>
  <Compile Update="Forms/*.Designer.cs">
    <DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Designer','')).cs</DependentUpon>
  </Compile>
  <Compile Update="Forms/MainForm.*.cs">
    <DependentUpon>MainForm.cs</DependentUpon>
  </Compile>
</ItemGroup>
<ItemGroup>
  <PackageReference Include="Markdig" Version="1.6.0" />
  <Compile Update="Forms/GuideViewer.cs;Forms/LoggingDialog.cs;Forms/ErrorDialog.cs">
    <SubType>Form</SubType>
  </Compile>
  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  <Content Include="../docs/**/*.md;../docs/**/*.png" Link="docs/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  <Compile Remove="Assets\PressetIcons.Designer.cs" />
  <Compile Update="Properties\Resources.Designer.cs">
    <DesignTime>True</DesignTime>
    <AutoGen>True</AutoGen>
    <DependentUpon>Resources.resx</DependentUpon>
  </Compile>
</ItemGroup>
<PropertyGroup>
  <PlatformTarget Condition="'$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
  <Prefer32Bit>false</Prefer32Bit>
</PropertyGroup>
<ItemGroup>
  <EmbeddedResource Remove="Assets\PressetIcons.resx" />
  <None Include="Assets\PressetIcons.resx" />
  <!-- Keep the comments and package the linked images without bitmap serialization at build time. -->
  <EmbeddedResource Include="Assets/PressetIcons.resx" Type="Non-Resx" WithCulture="false" LogicalName="CameraControlStudio.Assets.PressetIcons.xml" />
  <EmbeddedResource Update="Forms\*.resx" LogicalName="CameraControlStudio.%(Filename).resources" />
  <EmbeddedResource Update="Properties\Resources.resx">
    <Generator>ResXFileCodeGenerator</Generator>
    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
  </EmbeddedResource>
</ItemGroup>
<Target Name="EmbedLinkedPresetIcons" BeforeTargets="AssignTargetPaths">
  <XmlPeek XmlInputPath="Assets/PressetIcons.resx" Query="/root/data[starts-with(@type, 'System.Resources.ResXFileRef,')]/value/text()">
    <Output TaskParameter="Result" ItemName="_PresetIconFileReference" />
  </XmlPeek>
  <ItemGroup>
    <_PresetIconPath Include="$([System.String]::Copy('%(_PresetIconFileReference.Identity)').Split(';')[0])" Condition="'%(_PresetIconFileReference.Identity)' != ''" />
  </ItemGroup>
  <RemoveDuplicates Inputs="@(_PresetIconPath)">
    <Output TaskParameter="Filtered" ItemName="_UniquePresetIconPath" />
  </RemoveDuplicates>
  <ItemGroup>
    <EmbeddedResource Include="Assets/%(_UniquePresetIconPath.Identity)" Type="Non-Resx" WithCulture="false" LogicalName="CameraControlStudio.PresetIconFiles/%(_UniquePresetIconPath.Identity)" Condition="'%(_UniquePresetIconPath.Identity)' != ''" />
  </ItemGroup>
</Target>
</Project>

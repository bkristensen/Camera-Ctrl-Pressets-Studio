<Window x:Class="CamPressetsControlDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ptz="clr-namespace:CamPressetsControlDemo.Controls"
        Title="Cam Pressets Studio" Icon="Assets/CamPressetsStudio.ico" Width="1060" Height="670"
        MinWidth="850" MinHeight="530"
        Background="{StaticResource AppBackground}" Foreground="White"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <!-- Base blue sampled from the supplied reference. -->
    <SolidColorBrush x:Key="AppBackground" Color="#4B70A7"/>
    <SolidColorBrush x:Key="MutedText" Color="#E1ECFF"/>
    <SolidColorBrush x:Key="PanelFill" Color="#355D98"/>
    <LinearGradientBrush x:Key="ButtonFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#6D94C9" Offset="0"/>
      <GradientStop Color="#3E68A4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#60B2F6" Offset="0"/>
      <GradientStop Color="#2372D2" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource ButtonFill}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#A6C8F3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="#142D55" BlurRadius="13" ShadowDepth="4" Opacity="0.43"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#F0F9FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.76"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="13,12"/>
      <Setter Property="Margin" Value="2,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Foreground" Value="#203C64"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22,18,22,13">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="3,0,3,17">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="Assets/CamPressetsStudio.png" Width="47" Height="47" Stretch="Uniform" Margin="0,0,12,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Cam Pressets Studio" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock Text="Kamerastyring og gemte positioner" Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Profil" VerticalAlignment="Center" Margin="0,0,11,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="ProfilePicker" Width="205" DisplayMemberPath="Name" SelectionChanged="ProfilePicker_SelectionChanged"/>
        <Button Content="＋" ToolTip="Opret profil" Click="AddProfile_Click" Width="43" FontSize="20" Padding="4" Margin="7,0,0,0"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="370"/>
        <ColumnDefinition Width="305"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="20" Background="#225182" BorderBrush="#759BCB" BorderThickness="1" Padding="14">
        <Border.Effect><DropShadowEffect Color="#1C365A" BlurRadius="19" ShadowDepth="5" Opacity="0.32"/></Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="PANORERING" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource MutedText}" Margin="7,3,0,0"/>
          <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Viewbox Stretch="Uniform" Margin="0,3,4,3">
              <ptz:PanTiltWheel x:Name="Wheel" MovementStarted="Wheel_MovementStarted"
                                MovementStopped="Wheel_MovementStopped">
                <ptz:PanTiltWheel.Effect>
                  <DropShadowEffect Color="#11284D" BlurRadius="18" ShadowDepth="5" Opacity="0.55"/>
                </ptz:PanTiltWheel.Effect>
              </ptz:PanTiltWheel>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="ZOOM" TextAlignment="Center" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
              <Button x:Name="ZoomIn" Content="＋" FontSize="25" Height="62"
                      PreviewMouseLeftButtonDown="ZoomIn_Down" PreviewMouseLeftButtonUp="Zoom_Up" LostMouseCapture="Zoom_LostCapture"/>
              <TextBlock Text="Hold nede" Foreground="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" Margin="0,11"/>
              <Button x:Name="ZoomOut" Content="−" FontSize="25" Height="62"
                      PreviewMouseLeftButtonDown="ZoomOut_Down" PreviewMouseLeftButtonUp="Zoom_Up" LostMouseCapture="Zoom_LostCapture"/>
            </StackPanel>
          </Grid>
          <UniformGrid Grid.Row="2" Columns="2" Margin="2,8,2,2">
            <Button Content="⌂  Startposition" Click="Home_Click"/>
            <Button Content="⊙  Centrér" Click="Center_Click"/>
          </UniformGrid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Margin="17,0,0,0" CornerRadius="20" Background="#29568D" BorderBrush="#84A8DA" BorderThickness="1" Padding="15">
        <Border.Effect><DropShadowEffect Color="#1C365A" BlurRadius="17" ShadowDepth="5" Opacity="0.35"/></Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Gemte positioner" FontSize="19" FontWeight="SemiBold" Margin="3,4,0,6"/>
          <TextBlock Grid.Row="1" Text="Vælg en knap for at hente positionen" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedText}" Margin="3,0,0,12"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PresetList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource PresetButton}" Click="Preset_Click" Tag="{Binding}">
                    <DockPanel LastChildFill="True">
                      <TextBlock Text="›" FontSize="22" FontWeight="Bold" Foreground="#DDF2FF" Margin="0,-4,11,-4" DockPanel.Dock="Left"/>
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="3" Content="＋  Gem aktuel position" Background="{StaticResource AccentFill}"
                  FontWeight="SemiBold" Padding="13,14" Margin="2,14,2,1" Click="SavePreset_Click"/>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="Status" Text="Demo · Kamera ikke tilsluttet" FontSize="12"
               Foreground="{StaticResource MutedText}" Margin="5,13,0,0"/>
  </Grid>
</Window>

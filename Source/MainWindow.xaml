<Window x:Class="CamPressetsControlDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ptz="clr-namespace:CamPressetsControlDemo.Controls"
        Title="Cam Pressets Studio" Icon="Assets/CamPressetsStudio.ico"
        Width="1500" Height="920" MinWidth="1080" MinHeight="680"
        Background="#123D74" Foreground="White" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#CEE1FA"/>
    <SolidColorBrush x:Key="Stroke" Color="#6EA0D8"/>
    <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#244F89" Offset="0"/><GradientStop Color="#11335F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonBlue" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#4E83BD" Offset="0"/><GradientStop Color="#234E87" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrightBlue" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#49A6FF" Offset="0"/><GradientStop Color="#0960C4" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="PanelStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#061B38" BlurRadius="15" ShadowDepth="4" Opacity="0.55"/></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource ButtonBlue}"/>
      <Setter Property="BorderBrush" Value="#7EAFE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <Border.Effect><DropShadowEffect Color="#041C3D" BlurRadius="8" ShadowDepth="3" Opacity="0.48"/></Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#B5E9FF"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource BrightBlue}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="#17365C"/><Setter Property="Padding" Value="7,3"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="3,6"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="Slider"><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="1"/><Setter Property="AutoToolTipPlacement" Value="TopLeft"/><Setter Property="AutoToolTipPrecision" Value="0"/></Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="47"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1A4A85" BorderBrush="#5285C1" BorderThickness="0,0,0,1">
      <DockPanel Margin="22,9">
        <Image Source="Assets/CamPressetsStudio.png" Width="54" Height="54" Margin="0,0,12,0" DockPanel.Dock="Left"/>
        <TextBlock Text="Cam Pressets Studio" VerticalAlignment="Center" FontSize="29" FontWeight="SemiBold"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="16,15,16,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.06*" MinWidth="320"/>
        <ColumnDefinition Width="1.00*" MinWidth="290"/>
        <ColumnDefinition Width="1.06*" MinWidth="330"/>
      </Grid.ColumnDefinitions>

      <!-- Interactive camera control: retains the two rings. -->
      <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,12">
            <ptz:PanTiltWheel x:Name="Wheel" MovementStarted="Wheel_MovementStarted" MovementStopped="Wheel_MovementStopped">
              <ptz:PanTiltWheel.Effect><DropShadowEffect Color="#071D40" BlurRadius="15" ShadowDepth="5" Opacity="0.7"/></ptz:PanTiltWheel.Effect>
            </ptz:PanTiltWheel>
          </Viewbox>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,15">
            <Button x:Name="ZoomOut" Content="−" FontSize="27" Width="74" Height="56" ToolTip="Hold nede for at zoome ud" PreviewMouseLeftButtonDown="ZoomOut_Down" PreviewMouseLeftButtonUp="Zoom_Up" LostMouseCapture="Zoom_LostCapture"/>
            <TextBlock Text="Zoom" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
            <Button x:Name="ZoomIn" Content="+" FontSize="27" Width="74" Height="56" ToolTip="Hold nede for at zoome ind" PreviewMouseLeftButtonDown="ZoomIn_Down" PreviewMouseLeftButtonUp="Zoom_Up" LostMouseCapture="Zoom_LostCapture"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Profiles and presets. -->
      <Grid Grid.Column="1" Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Profil:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="1" x:Name="ProfilePicker" DisplayMemberPath="Name" SelectionChanged="ProfilePicker_SelectionChanged" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Content="+" FontSize="20" Width="39" Height="35" ToolTip="Opret profil" Click="AddProfile_Click"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="☷  Presets" Style="{StaticResource SectionHeading}"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="PresetList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2,0,5">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="39"/></Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Tag="{Binding}" Click="Preset_Click" HorizontalContentAlignment="Stretch" Padding="10,11">
                        <DockPanel><TextBlock Text="▶" FontSize="12" Margin="0,0,11,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="14"/></DockPanel>
                      </Button>
                      <Button Grid.Column="1" Content="✎" Tag="{Binding}" ToolTip="Omdøb preset" Click="RenamePreset_Click"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="＋  Gem aktuel position" Style="{StaticResource PrimaryButton}" Click="SavePreset_Click" Padding="9,12"/>
              <Button Grid.Column="1" Content="🗑" ToolTip="Slet seneste preset" Click="DeletePreset_Click"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Settings stay visible in the same window. -->
      <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="{StaticResource BrightBlue}" CornerRadius="14,14,0,0" Padding="16,10">
            <TextBlock Text="⚙  Indstillinger" FontWeight="SemiBold" FontSize="18"/>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15,13,15,10">
            <StackPanel>
              <TextBlock Text="Kamerahastighed (steps)" Style="{StaticResource SectionHeading}"/>
              <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                <TextBlock Text="Normal hastighed" VerticalAlignment="Center"/>
                <Slider x:Name="NormalSpeed" Grid.Column="1" Minimum="1" Maximum="50" Value="8" ValueChanged="SettingsChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding ElementName=NormalSpeed,Path=Value,StringFormat=F0}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                <TextBlock Text="Hurtig hastighed" VerticalAlignment="Center"/>
                <Slider x:Name="FastSpeed" Grid.Column="1" Minimum="1" Maximum="50" Value="32" ValueChanged="SettingsChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding ElementName=FastSpeed,Path=Value,StringFormat=F0}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Separator Background="#4778AE" Margin="0,2,0,13"/>
              <TextBlock Text="Zoom hastighed (steps)" Style="{StaticResource SectionHeading}"/>
              <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                <TextBlock Text="Zoom hastighed" VerticalAlignment="Center"/>
                <Slider x:Name="ZoomSpeed" Grid.Column="1" Minimum="1" Maximum="50" Value="12" ValueChanged="SettingsChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding ElementName=ZoomSpeed,Path=Value,StringFormat=F0}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Separator Background="#4778AE" Margin="0,2,0,13"/>
              <TextBlock Text="Start programmer" Style="{StaticResource SectionHeading}"/>
              <CheckBox x:Name="JwEnabled" Content="JW Library" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <CheckBox x:Name="ZoomEnabled" Content="Zoom" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <Button Content="＋  Tilføj program..." HorizontalAlignment="Center" Padding="14,6" Margin="0,7" Click="AddProgram_Click"/>
              <ItemsControl x:Name="ExtraProgramsList">
                <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="ExtraProgram_Click"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox x:Name="LaunchAtStartup" Content="Start programmer ved opstart" FontWeight="SemiBold" Margin="3,10,0,13" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <Separator Background="#4778AE" Margin="0,0,0,13"/>
              <TextBlock Text="Kamera" Style="{StaticResource SectionHeading}"/>
              <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Vælg kamera:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="CameraPicker" SelectionChanged="SettingsChanged" ToolTip="Demo: kameraforbindelsen er endnu ikke implementeret"/>
              </Grid>
              <Separator Background="#4778AE" Margin="0,0,0,12"/>
              <CheckBox x:Name="AlwaysOnTop" Content="Altid øverst" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <TextBlock Text="Kamera og positioner er simulerede i denne version." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,18,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#0F325B" BorderBrush="#4F81BD" BorderThickness="0,1,0,0">
      <DockPanel Margin="17,9"><TextBlock x:Name="Status" Text="Kamera: Demo · Profil: Standard" FontSize="12" Foreground="#E3EEFF" VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right" Text="Demo · v1.0" HorizontalAlignment="Right" FontSize="12" Foreground="#B6D5F5"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>

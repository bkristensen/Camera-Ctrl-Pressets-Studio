<Project>
  <PropertyGroup>
    <Product>Camera Control Studio</Product>
    <Authors>Brian Kristensen and contributors</Authors>
    <Company>Brian Kristensen and contributors</Company>
    <Copyright>Copyright (c) 2026 Cam Pressets contributors</Copyright>
    <Description>Camera controls and position presets</Description>
    <RepositoryUrl>https://github.com/bkristensen/Camera-Ctrl-Pressets-Studio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.7.0-beta.7</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'CameraControlStudio'">
    <AssemblyMetadata Include="ProjectUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="License" Value="$(PackageLicenseExpression)" />
  </ItemGroup>
</Project>
